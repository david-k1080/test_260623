# 이 파일을 복사해 'deploy/.env' 를 만들고 값을 채우세요:  cp .env.example .env && chmod 600 .env
# 이 파일은 서버에만 두고, 채팅·메일·깃에 올리지 마세요.

# ── 필수 ───────────────────────────────────────────────
# 이 서버를 가리키는 도메인. 도메인이 없으면 '서버공인IP.sslip.io' (점 대신 하이픈): 예) 203-0-113-10.sslip.io
DOMAIN=meet.example.com

# 참가 코드: 이 코드를 아는 사람만 입장합니다. 8자 이상 무작위 문자열을 쓰세요.  (만들기: openssl rand -base64 12)
ACCESS_CODE=

# 번역용 (Google AI Studio 키. 결제가 연결된 프로젝트의 키를 권장)
GEMINI_API_KEY=

# ── 선택 ───────────────────────────────────────────────
# 음성 인식 (없으면 폰 브라우저 내장 인식으로 대체되어 정확도가 낮습니다)
DEEPGRAM_API_KEY=
# Claude로 번역하려면 위 GEMINI_API_KEY 대신 사용
# ANTHROPIC_API_KEY=

# ── 운영 한도 (기본값이 있으니 필요할 때만 조정) ─────────
# MAX_ROOMS=20              동시에 진행되는 방 수
# MAX_ROOM_CLIENTS=12       방 하나의 최대 인원
# MAX_STT_SESSIONS=8        동시에 켜지는 음성 인식 수 (Deepgram 요금 보호)
# UTTER_PER_MIN=40          한 사람이 1분에 만들 수 있는 문장 수 (번역 요금 보호)
# MAX_BAD_CODES=5           참가 코드를 틀릴 수 있는 횟수 (넘으면 10분 잠김)
# MINUTES_RETENTION_DAYS=30 회의록 자동 삭제 기간(일). 0이면 삭제하지 않음
# MINUTES_SAVE=0            회의록을 서버에 저장하지 않으려면 0
