# 이 파일을 복사해서 이름을 interpreter.env 로 바꾸고 값을 채우세요.
# (interpreter.env 는 git에 올라가지 않습니다. 따옴표 없이, = 바로 뒤에 키를 붙여 넣기)

# [필수] 번역·요약 — Google AI Studio 에서 발급. 유료(결제 연결) 프로젝트의 키를 쓰세요.
GEMINI_API_KEY=

# [권장] 음성 인식 — Deepgram. 있으면 한국어·영어를 자동으로 구분해서 듣고 정확도도 높습니다.
# 비워 두면 Chrome 내장 음성 인식을 쓰며, 한 번에 한 언어만 듣습니다.
DEEPGRAM_API_KEY=

# 포트를 바꾸고 싶을 때만
# PORT=3000
